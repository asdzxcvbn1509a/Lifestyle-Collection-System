# Base URL of the backend API — must end with /api.
# Leave EMPTY in local dev to use the Vite proxy (/api -> http://localhost:4000).
# In production (Vercel), set this to the backend origin, e.g.
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=

# Google OAuth client ID for "Login with Google" (same value as the server's
# GOOGLE_CLIENT_ID). Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
